# Self-signed cert generated by Terraform on apply, imported into ACM.
# Browser will warn about untrusted issuer; acceptable for v0 single-user iteration.
# Replace with a real ACM cert + Route 53 record when promoting beyond v0.

resource "tls_private_key" "self_signed" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_self_signed_cert" "alb" {
  private_key_pem = tls_private_key.self_signed.private_key_pem

  subject {
    common_name  = "${local.name}.local"
    organization = "Shermin Finance Ltd"
  }

  # 1 year — rotate before expiry by recreating this resource (taint or destroy).
  validity_period_hours = 8760
  early_renewal_hours   = 720

  allowed_uses = [
    "key_encipherment",
    "digital_signature",
    "server_auth",
  ]

  dns_names = [
    "${local.name}.local",
    "*.elb.amazonaws.com",
  ]
}

resource "aws_acm_certificate" "alb" {
  private_key      = tls_private_key.self_signed.private_key_pem
  certificate_body = tls_self_signed_cert.alb.cert_pem

  lifecycle {
    create_before_destroy = true
  }

  tags = {
    Name = "${local.name}-self-signed"
  }
}

resource "aws_lb" "main" {
  name               = "${local.name}-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = aws_subnet.public[*].id

  enable_deletion_protection = false # v0
  idle_timeout               = 60

  tags = {
    Name = "${local.name}-alb"
  }
}

resource "aws_lb_target_group" "twenty" {
  name        = "${local.name}-tg"
  port        = 3000
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "instance"

  health_check {
    path                = "/healthz"
    port                = "3000"
    protocol            = "HTTP"
    healthy_threshold   = 2
    unhealthy_threshold = 5
    timeout             = 10
    interval            = 30
    matcher             = "200-299"
  }

  deregistration_delay = 30

  tags = {
    Name = "${local.name}-tg"
  }
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.main.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = aws_acm_certificate.alb.arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.twenty.arn
  }
}

resource "aws_lb_target_group_attachment" "twenty" {
  target_group_arn = aws_lb_target_group.twenty.arn
  target_id        = aws_instance.twenty.id
  port             = 3000
}
