# Shermin's Twenty image — derived from upstream with the per-file upload
# limit lifted from 10 MB to a configurable build-arg default.
#
# The constant lives in:
#   /app/packages/twenty-server/dist/engine/constants/settings/index.js
# at line 24:
#   maxFileSize: '10MB'
#
# We sed-patch the compiled output. This is fragile in principle (compiled JS
# can change shape between releases), so the build verifies the substitution
# actually happened before declaring success — if upstream renames or restructures
# the constant, the build fails loudly rather than silently shipping a 10 MB cap.
#
# When we bump the upstream tag, re-test this build. If sed misses, regenerate
# the patch by inspecting the new dist file.
#
# Eventually we should upstream a STORAGE_MAX_FILE_SIZE env-var override and
# delete this Dockerfile.

ARG TWENTY_TAG=v2.1.0
FROM twentycrm/twenty:${TWENTY_TAG}

# ARGs declared before FROM are only visible in FROM; redeclare for use in
# later instructions (RUN, LABEL).
ARG TWENTY_TAG
ARG MAX_FILE_SIZE=100MB

# Patch the compiled settings constant.
RUN set -eux; \
    SETTINGS_FILE=/app/packages/twenty-server/dist/engine/constants/settings/index.js; \
    test -f "$SETTINGS_FILE"; \
    grep -q "maxFileSize: '10MB'" "$SETTINGS_FILE"; \
    sed -i "s/maxFileSize: '10MB'/maxFileSize: '${MAX_FILE_SIZE}'/" "$SETTINGS_FILE"; \
    grep -q "maxFileSize: '${MAX_FILE_SIZE}'" "$SETTINGS_FILE"; \
    echo "Patched maxFileSize to ${MAX_FILE_SIZE}"

# Stax brand override CSS — replaces Twenty's blue (indigo) and pink scales
# with Stax slate blue and Stax pink. Loaded by index.html AFTER Twenty's
# own compiled CSS so it wins by source order.
COPY shermin-overrides.css /app/packages/twenty-server/dist/front/shermin-overrides.css

# Inject <link> into index.html so the override loads on every page request.
# Verified via grep that the injection actually happened — fails the build if
# upstream changes the index.html structure under us.
RUN set -eux; \
    INDEX=/app/packages/twenty-server/dist/front/index.html; \
    test -f "$INDEX"; \
    grep -q "</head>" "$INDEX"; \
    sed -i 's|</head>|<link rel="stylesheet" href="/shermin-overrides.css" data-shermin="true" />\n</head>|' "$INDEX"; \
    grep -q "shermin-overrides.css" "$INDEX"; \
    echo "Injected shermin-overrides.css link"

LABEL org.shermin.fork="twenty-shermin"
LABEL org.shermin.upstream-tag="${TWENTY_TAG}"
LABEL org.shermin.max-file-size="${MAX_FILE_SIZE}"
LABEL org.shermin.brand="stax-slate-blue-pink"
